__pycache__/
venv/
.venv/
*.pyc
*.pyo
*.pyd
.Python
*.tmp
logs/
settings.json
# Generated by CI at build time (git sha + run number); never committed.
app/_build_info.py

# macOS-Ordnerkrempel. War versehentlich eingecheckt und tauchte deshalb bei
# jedem `git status` als geändert auf.
.DS_Store

# graphify: Ausgabe wird eingecheckt, Zwischenstände nicht.
# cache/ ist an die Tool-Version gebunden und regenerierbar, .graphify_root und
# .graphify_python enthalten absolute Pfade dieser Maschine, cost.json zählt
# Token pro Lauf – alles drei erzeugt nur Diff-Rauschen.
graphify-out/cache/
graphify-out/.graphify_root
graphify-out/.graphify_python
graphify-out/cost.json
graphify-out/.graphify_*.json
graphify-out/.graphify_*.txt
!graphify-out/.graphify_labels.json
